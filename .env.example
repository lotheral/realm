# REALM environment template — copy to .env and fill in real values.
# Do NOT commit .env (it's gitignored). This .env.example IS committed
# so contributors / readers can see which variables exist.

# ─── LLM backend gate ─────────────────────────────────────────────────
# Master switch: when unset, REALM stays in simulation-only mode
# regardless of whether API keys are present below. Set to "1" / "true"
# / "yes" / "on" to enable LLM-first routing + question / scenario /
# narrative analyzers.
REALM_LLM_CATEGORY_BACKEND=1

# ─── LLM provider keys (at least one required when gate is on) ────────
# Moonshot (Kimi k2.x). Get a key at https://platform.moonshot.cn
MOONSHOT_API_KEY=
REALM_MOONSHOT_MODEL=kimi-k2.6

# OpenAI (GPT-5.x). Get a key at https://platform.openai.com
OPENAI_API_KEY=
# NOTE: verify your key's model access with `python scripts/smoke_external.py`
# after any dormant period — provider catalogs churn and a stale model id
# silently degrades REALM to sim-only mode.
REALM_OPENAI_MODEL=gpt-5.6-sol

# Optional: Ollama (local inference). Default host shown.
# OLLAMA_HOST=http://localhost:11434
# REALM_OLLAMA_MODEL=qwen2.5:14b

# ─── Web research grounding (Sprint 18, optional) ─────────────────────
# When a search-provider key is set, the question analyzer LLM gets
# 2-3 web-search results folded into its prompt — much better priors
# for current-event questions. Provider auto-detected from key
# presence (Tavily preferred over Brave when both are set).
#
# Tavily: https://tavily.com (purpose-built for LLM workflows)
TAVILY_API_KEY=
# Brave Search: https://api.search.brave.com (generous free tier)
# BRAVE_API_KEY=

# Optional explicit provider override (auto-detect handles this when
# unset, so leaving commented is fine):
# REALM_WEB_SEARCH_PROVIDER=tavily

# ─── Kerykeion (natal-chart engine, optional) ─────────────────────────
# Kerykeion's default GeoNames quota is shared across ALL users of the
# library — set your own free username to skip the warning + quota.
# Sign up at https://www.geonames.org/login (also enable "free web
# services" at https://www.geonames.org/manageaccount after signup).
KERYKEION_GEONAMES_USERNAME=
